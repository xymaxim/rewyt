<script lang="ts">
 import { Slider } from "bits-ui";
 import { getExplorerContext } from "../explorer.svelte.js";
 import { snapTime, formatHoverTime } from "../utils/timelineUtils";
 import { onMount } from "svelte";

 const explorer = getExplorerContext();

 const thumbSize = 32;
 const thumbOffset = thumbSize / 2;

 const thumbPercent = $derived(
     rangeEnd > rangeStart
              ? ((rawValue - rangeStart) / (rangeEnd - rangeStart)) * 100
              : 0
 );

 const labelFlipped = $derived(thumbPercent > 80);

 const rangeStart = $derived(explorer.viewRange?.start ?? 0);
 const rangeEnd = $derived(explorer.viewRange?.end ?? 0);
 const spanMs = $derived(rangeEnd - rangeStart);

 let rawValue = $state(explorer.selectedTime ?? rangeStart);
 let isSliding = $state(false);

 $effect(() => {
     if (isSliding) return;
     if (explorer.dragTime !== null) {
         rawValue = explorer.dragTime;
     } else {
         rawValue = explorer.selectedTime ?? rangeStart;
     }
 });
 
 const snappedValue = $derived(snapTime(rawValue, spanMs));
 const label = $derived(formatHoverTime(snappedValue, spanMs, explorer.timezoneOffset));

 onMount(() => {
     const handler = () => {
         if (!isSliding) return;
         isSliding = false;
         explorer.setSelectedTime(snappedValue);
         explorer.setDragTime(null);
     };
     window.addEventListener("pointerup", handler);
     return () => window.removeEventListener("pointerup", handler);
 });

</script>

{#if explorer.viewRange !== null && explorer.selectedTime !== null}
    <div class="relative flex h-full w-full items-center">
        <div class="absolute inset-y-0"
             style="left: -{thumbOffset}px; right: -{thumbOffset}px;">
        <Slider.Root
            value={[rawValue]}
            onValueChange={(v) => {
                          if (!isSliding) return;
                          if (v[0] === undefined) return;
                          rawValue = v[0];
                          explorer.setDragTime(v[0]);
                          }}
            onpointerdown={() => (isSliding = true)}
            onpointerup={() => {
                        isSliding = false;
                        explorer.setSelectedTime(snappedValue);
                        explorer.setDragTime(snappedValue);
                        }}
            min={rangeStart}
            max={rangeEnd}
            step={1000}
            class="relative flex h-full w-full touch-none items-center"
            >
            <Slider.Track class="relative h-full w-full overflow-hidden rounded-full bg-transparent">
                <Slider.Range class="absolute h-full bg-transparent" />
            </Slider.Track>

            <Slider.Thumb
                index={0}
                class="relative flex size-8 cursor-ew-resize items-center justify-center
                      rounded-full bg-[var(--rewyt-selected-600)] outline-none"
            >
                <span
                    class="pointer-events-none absolute select-none tabular-nums font-medium whitespace-nowrap text-sm"
                    class:left-full={!labelFlipped}
                    class:ml-2={!labelFlipped}
                    class:right-full={labelFlipped}
                    class:mr-2={labelFlipped}
                >
                    {label}
                </span>
            </Slider.Thumb>
        </Slider.Root>
        </div>
    </div>
{/if}
